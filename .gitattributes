# Git 行尾规则（防止 Windows 的 autocrlf 把关键文件改成 CRLF）
# ---------------------------------------------------------------------
# scf_bootstrap 是 HTTP 型云函数的启动脚本，在 Linux 容器里执行；
# 只要混进一个 \r（Windows 回车符），容器就找不到解释器、启动脚本失效，
# 云函数会部署失败或根本起不来（Day 25 踩过的坑）。
# 所以把它钉死为永远 LF，无论在什么系统上克隆/检出都不变。
scf_bootstrap text eol=lf
